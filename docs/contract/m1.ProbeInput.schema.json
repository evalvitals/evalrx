{
  "$defs": {
    "CaseBatchRef": {
      "additionalProperties": false,
      "description": "A batch referenced by file rather than inlined (the normal case).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "n_cases": {
          "title": "N Cases",
          "type": "integer"
        },
        "split": {
          "anyOf": [
            {
              "enum": [
                "all",
                "explore",
                "confirm",
                "discovery"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Split"
        }
      },
      "required": [
        "path",
        "n_cases"
      ],
      "title": "CaseBatchRef",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "description": "Identity + declared capabilities of the model under diagnosis.\n\n``modalities`` is a SET, matched by subset against each analyzer's\n``applies_to_modalities``. Adding a modality adds one member here, not a new\ncombination type.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend"
        },
        "modalities": {
          "items": {
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "type": "string"
          },
          "title": "Modalities",
          "type": "array"
        },
        "capabilities": {
          "description": "e.g. GENERATE / LOGPROBS / ATTENTION / HIDDEN_STATES.",
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "ProtocolWire": {
      "additionalProperties": true,
      "description": "The user's natural-language statement of what to investigate.\n\nCarried through to M2 (tool selection), M3 (prompt) and M5 (the\nprotocol-consistency gate) — a hypothesis can be statistically real and still\nbe off-topic, and only this makes that judgeable.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "task_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Domain"
        },
        "probe_hints": {
          "items": {
            "type": "string"
          },
          "title": "Probe Hints",
          "type": "array"
        }
      },
      "required": [
        "description"
      ],
      "title": "ProtocolWire",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything M1 needs. Cases are referenced, not inlined — a batch is large\nand is already persisted.",
  "properties": {
    "model": {
      "$ref": "#/$defs/ModelRef"
    },
    "data": {
      "$ref": "#/$defs/CaseBatchRef"
    },
    "protocol": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProtocolWire"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prior_hypotheses": {
      "description": "Hypothesis ids from earlier cycles, for focused re-probing.",
      "items": {
        "type": "string"
      },
      "title": "Prior Hypotheses",
      "type": "array"
    },
    "hint_failure_modes": {
      "description": "Failure-mode tags used by the no-judge fallback selector.",
      "items": {
        "type": "string"
      },
      "title": "Hint Failure Modes",
      "type": "array"
    }
  },
  "required": [
    "model",
    "data"
  ],
  "title": "ProbeInput",
  "type": "object",
  "$id": "https://evalvitals.dev/contract/m1.ProbeInput.json",
  "x-stage": "m1",
  "x-role": "input",
  "x-schema-version": 4,
  "x-optional-stage": false
}
