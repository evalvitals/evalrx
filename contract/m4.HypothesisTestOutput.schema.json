{
  "$defs": {
    "EvidenceGrade": {
      "description": "Strength tier of the deciding evidence.\n\n``INTERVENTION`` beats ``OBSERVATIONAL``: a paired contrast changed one\nvariable and re-ran, so it carries causal weight an association does not.",
      "enum": [
        "intervention",
        "observational",
        "none"
      ],
      "title": "EvidenceGrade",
      "type": "string"
    },
    "HypothesisStatus": {
      "enum": [
        "proposed",
        "testing",
        "supported",
        "refuted",
        "inconclusive"
      ],
      "title": "HypothesisStatus",
      "type": "string"
    },
    "HypothesisTestResultWire": {
      "additionalProperties": false,
      "description": "One hypothesis's verdict.\n\n``effect_size`` is signal-group minus control-group fail rate, so its SIGN is\nthe verdict's direction: positive supports the claim, negative refutes it.\nA refutation is a real, useful outcome — not a failure to conclude.",
      "properties": {
        "hypothesis_id": {
          "description": "Points into the M3 DiagnosisOutput.",
          "minLength": 1,
          "title": "Hypothesis Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/HypothesisStatus"
        },
        "test_name": {
          "description": "e.g. 'signal_label_assoc' / 'fail_rate_comparison'.",
          "title": "Test Name",
          "type": "string"
        },
        "effect_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Size"
        },
        "confidence": {
          "description": "Geometric mean of evidence gap, sample adequacy, control cleanliness.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_grade": {
          "$ref": "#/$defs/EvidenceGrade",
          "default": "observational"
        },
        "is_consistent_with_protocol": {
          "title": "Is Consistent With Protocol",
          "type": "boolean"
        },
        "verdict": {
          "description": "One-line natural-language summary.",
          "title": "Verdict",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/TestEvidence"
        }
      },
      "required": [
        "hypothesis_id",
        "status",
        "test_name",
        "confidence",
        "is_consistent_with_protocol",
        "verdict"
      ],
      "title": "HypothesisTestResultWire",
      "type": "object"
    },
    "JoinReport": {
      "additionalProperties": false,
      "description": "Health of one ``sample_id`` <-> ``FailureCase.id`` join.\n\nThis exists because a broken join and a real null result are indistinguishable\ndownstream: unmatched ids are skipped, both groups come out empty, and the\ntool reports \"no significant association\" — the same output as a model with\nno defect. Emitting coverage makes \"the pipeline is broken\" a separate,\nvisible state from \"the model is fine\".",
      "properties": {
        "left": {
          "description": "e.g. 'attention.findings.per_case'",
          "title": "Left",
          "type": "string"
        },
        "right": {
          "description": "e.g. 'CaseBatch(explore)'",
          "title": "Right",
          "type": "string"
        },
        "n_left": {
          "title": "N Left",
          "type": "integer"
        },
        "n_right": {
          "title": "N Right",
          "type": "integer"
        },
        "n_matched": {
          "title": "N Matched",
          "type": "integer"
        },
        "coverage": {
          "description": "n_matched / n_left",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage",
          "type": "number"
        },
        "unmatched_sample": {
          "description": "First few unmatched ids, for triage.",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Unmatched Sample",
          "type": "array"
        }
      },
      "required": [
        "left",
        "right",
        "n_left",
        "n_right",
        "n_matched",
        "coverage"
      ],
      "title": "JoinReport",
      "type": "object"
    },
    "StageState": {
      "description": "Per-stage UI state. A single generic \"N/A\" loses information the reader\nneeds — in particular ``EMPTY`` (ran, produced nothing) and ``FAILED``\n(did not run correctly) must never render the same.",
      "enum": [
        "not_started",
        "running",
        "succeeded",
        "empty",
        "abstained",
        "partial",
        "failed",
        "skipped",
        "unavailable"
      ],
      "title": "StageState",
      "type": "string"
    },
    "StageStatus": {
      "additionalProperties": false,
      "description": "Terminal state of one stage in one cycle.\n\n``EMPTY`` and ``ABSTAINED`` are successes with nothing to show; ``FAILED``\nand ``UNAVAILABLE`` are not. Collapsing them loses the only signal a reader\nhas for whether to trust the absence of a result.",
      "properties": {
        "stage": {
          "enum": [
            "pre_m1",
            "m1",
            "explore",
            "m2",
            "m3",
            "m5_surgery",
            "m5_fix",
            "m4"
          ],
          "title": "Stage",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/StageState"
        },
        "cycle": {
          "description": "Normal cycles start at 0; the post-loop fix uses -1.",
          "title": "Cycle",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why, for any state that is not plain success — the skip rule, the error, the reason for abstaining. One field, because a reader wants one answer.",
          "title": "Reason"
        },
        "duration_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Sec"
        },
        "joins": {
          "items": {
            "$ref": "#/$defs/JoinReport"
          },
          "title": "Joins",
          "type": "array"
        }
      },
      "required": [
        "stage",
        "state",
        "cycle"
      ],
      "title": "StageStatus",
      "type": "object"
    },
    "TestEvidence": {
      "additionalProperties": false,
      "description": "The statistics behind one verdict, with its provenance.",
      "properties": {
        "source": {
          "default": "none",
          "enum": [
            "m2_stats_results",
            "fallback_per_case",
            "none"
          ],
          "title": "Source",
          "type": "string"
        },
        "chosen_tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chosen Tool"
        },
        "routed_by": {
          "default": "",
          "description": "How test_design resolved to this result.",
          "title": "Routed By",
          "type": "string"
        },
        "consulted_tools": {
          "items": {
            "type": "string"
          },
          "title": "Consulted Tools",
          "type": "array"
        },
        "ci": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci"
        },
        "e_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "E Value"
        },
        "fdr_corrected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The field that actually decided this.",
          "title": "Fdr Corrected"
        },
        "underpowered": {
          "default": false,
          "title": "Underpowered",
          "type": "boolean"
        },
        "n_signal": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Signal"
        },
        "n_control": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Control"
        },
        "fail_rate_signal": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fail Rate Signal"
        },
        "fail_rate_control": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fail Rate Control"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "title": "TestEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "M4's serialized output — one result per hypothesis, plus the loop gate.",
  "properties": {
    "schema_version": {
      "default": 5,
      "title": "Schema Version",
      "type": "integer"
    },
    "trace_id": {
      "description": "Run-level correlation id.",
      "title": "Trace Id",
      "type": "string"
    },
    "span_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "e.g. 'c0.m1'.",
      "title": "Span Id"
    },
    "cycle": {
      "default": 0,
      "title": "Cycle",
      "type": "integer"
    },
    "produced_at": {
      "description": "ISO-8601 UTC.",
      "title": "Produced At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/StageStatus"
    },
    "split": {
      "default": "explore",
      "enum": [
        "explore",
        "confirm",
        "all"
      ],
      "title": "Split",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/HypothesisTestResultWire"
      },
      "title": "Results",
      "type": "array"
    },
    "stopping_criteria_met": {
      "default": false,
      "description": "Whether the loop may stop on this cycle's evidence. Not simply `verified() != []` — the depth-tiered rule also weighs evidence grade.",
      "title": "Stopping Criteria Met",
      "type": "boolean"
    }
  },
  "required": [
    "trace_id",
    "produced_at",
    "status"
  ],
  "title": "HypothesisTestOutput",
  "type": "object",
  "$id": "https://evalrx.dev/contract/m4.HypothesisTestOutput.json",
  "x-stage": "m4",
  "x-role": "output",
  "x-schema-version": 5,
  "x-optional-stage": false
}
