# examples/benchmark host settings — copy to examples/benchmark/.env (every leaf
# links to it). All optional: the compose files default to the usual $HOME paths.
#
# Where the docker daemon can read weights / the judge CLI state. On tealab the
# daemon cannot traverse the root-squashed NFS home, so everything lives on
# /tealab-data (see the m1_m4 examples' docker-compose.override.yml history).
#EVALVITALS_HF_CACHE=/tealab-data/<you>/hf_cache
#CLAUDE_PATH=/tealab-data/<you>/claude-bin
#CLAUDE_HOME=/tealab-data/<you>/claude-home
#CLAUDE_JSON=/tealab-data/<you>/claude.json
# Hub token for gated checkpoints (none of the matrix's current repos are gated).
#HF_TOKEN=hf_...
# Default card(s); override per run with CUDA_VISIBLE_DEVICES=... on the command line.
#CUDA_VISIBLE_DEVICES=0
