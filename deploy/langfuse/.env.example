# Copy to .env and replace every value before starting the stack.
POSTGRES_PASSWORD=replace-with-a-long-random-password
CLICKHOUSE_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
REDIS_AUTH=replace-with-a-long-random-password
SALT=replace-with-a-long-random-random-string
ENCRYPTION_KEY=replace-with-64-hex-characters
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Set either bind address to 0.0.0.0 only behind an authenticated reverse proxy.
LANGFUSE_WEB_BIND_ADDRESS=127.0.0.1
LANGFUSE_MINIO_BIND_ADDRESS=127.0.0.1
